# Copy to server/.env for local development. Never commit .env.

NODE_ENV=development
PORT=4000

# Local MongoDB or an Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/eventsphere

# JWT secrets: long random strings (required in production)
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# Where the React client runs; used for CORS, email links and OAuth redirects
CLIENT_URL=http://localhost:5173
# Extra allowed origins, comma-separated (e.g. Vercel preview URLs)
CORS_ORIGINS=
# Refresh cookie SameSite: lax when the client proxies /api (default), none for cross-site setups
COOKIE_SAMESITE=lax

# Google sign-in (optional). Callback must be https://<client-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Poster uploads go to Cloudinary when set; otherwise to server/uploads (dev only)
CLOUDINARY_URL=

# SMTP (optional). Without SMTP_HOST, emails are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EventSphere <no-reply@eventsphere.dev>

# Demo mode enables POST /api/admin/reseed (with RESEED_SECRET) for the nightly refresh
DEMO_MODE=true
RESEED_SECRET=
